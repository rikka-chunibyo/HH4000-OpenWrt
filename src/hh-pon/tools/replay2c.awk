# replay2c.awk - turn work/pon/gpon/replay/replay_init.txt into C tables.
# Usage: awk -f replay2c.awk replay_init.txt > kmod/gen/hh_pon_replay.h
# Section "## WAN SerDes..." -> hh_serdes_gpon[], "## GPON MAC..." -> hh_mac_init[].
# Only MMIO writes inside the WAN-top / GPON TX / GPON RX windows are kept.
BEGIN {
	print "/* SPDX-License-Identifier: GPL-2.0-only */"
	print "/* GENERATED by tools/replay2c.awk from work/pon/gpon/replay/replay_init.txt - do not edit."
	print " * Values were recovered by emulating the stock bcm_pondrv/gponstack init (docs/13 2.3, 4.3). */"
	print "#ifndef HH_PON_REPLAY_H\n#define HH_PON_REPLAY_H\n"
	print "enum hh_rp_kind { HH_RP_MMIO, HH_RP_PMD, HH_RP_WAIT };"
	print "struct hh_rp { unsigned char kind; unsigned short devad; unsigned int addr, val, mask; };\n"
	sec = ""
}
function close_sec() { if (sec != "") { print "};\n#define " toupper(sec) "_LEN " n "\n"; } }
/^## WAN SerDes/ { close_sec(); sec = "hh_serdes_gpon"; n = 0; print "static const struct hh_rp " sec "[] = {"; next }
/^## GPON MAC/   { close_sec(); sec = "hh_mac_init"; n = 0; print "static const struct hh_rp " sec "[] = {"; next }
/^# ENTER/ { if (sec != "") { $1 = ""; $2 = ""; printf "\t/* %s */\n", substr($0, 3) } next }
sec == "" { next }
$1 == "MMIO" {
	a = strtonum($2)
	if (a < 0x80144000 || a >= 0x80158000) { printf "\t/* skipped %s %s (outside PON MAC/WAN top) */\n", $2, $3; next }
	cmt = ""; if (index($0, "#")) cmt = substr($0, index($0, "#") + 2); gsub(/\*\//, "", cmt)
	printf "\t{ HH_RP_MMIO, 0, %s, %s, 0xffffffff },\t/* %.60s */\n", $2, $3, cmt; n++; next
}
$1 == "PMD"  { printf "\t{ HH_RP_PMD, %s, %s, %s, %s },\n", $2, $3, $4, $5; n++; next }
$1 == "WAIT" {
	us = strtonum($2); if ($3 == "ms") us *= 1000
	printf "\t{ HH_RP_WAIT, 0, 0, %d, 0 },\n", us; n++; next
}
END { close_sec(); print "#endif" }
