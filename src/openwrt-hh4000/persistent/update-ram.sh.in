#!/bin/sh
# Generated by tools/hh_firmware_update.py. Run ONLY in the maintenance RAM OS.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "$(id -u)" = 0 ] || { echo HH_UPDATE_FAILED: requires-root >&2; exit 1; }
BB=/rescue/busybox
D=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
DATA=/mnt/hh-update-data
LOCK=/tmp/hh-firmware-update.lock
mounted=0
fail() { echo "HH_UPDATE_FAILED: $*" >&2; exit 1; }
check_hash() { [ "$(sha256sum "$1" | cut -d ' ' -f1)" = "$2" ] || fail "hash: $1"; }
cleanup() {
 [ "$mounted" = 0 ] || { sync; "$BB" umount "$DATA" || echo HH_UPDATE_DATA_UNMOUNT_FAILED >&2; }
 rm -f "$LOCK/managed-paths"
 rmdir "$LOCK" 2>/dev/null || true
}
case "${1:---preflight}" in --preflight|--install) action=${1:---preflight};; *) fail unknown-action;; esac
[ "$(cat /tmp/hh-storage-mode 2>/dev/null)" = RAM ] || fail requires-maintenance-RAM
[ "$(uname -r)" = 4.1.52-5.02L.07 ] || fail kernel-ABI
[ "$(tr -d '\000' </proc/device-tree/compatible)" = brcm,brcm-v8A ] || fail device-tree
"$BB" grep -q '^/dev/loop0 /rom squashfs ro' /proc/mounts || fail root-not-embedded
[ "$(cat /sys/class/ubi/ubi0/mtd_num)" = 3 ] || fail firmware-mapping
[ "$(cat /sys/class/ubi/ubi0_6/name)" = owrt-root ] || fail root-volume
[ "$(cat /sys/class/ubi/ubi0_8/name)" = owrt-init ] || fail bootstrap-volume
for device in /dev/ubi0_6 /dev/ubi0_8; do
 ! "$BB" grep -q "^$device " /proc/mounts || fail firmware-mounted
done
mkdir "$LOCK" || fail updater-already-running
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
check_hash "$D/root.squashfs" @ROOT_HASH@
check_hash "$D/bootstrap.uImage" @INIT_HASH@
[ "$(wc -c <"$D/root.squashfs")" = @ROOT_BYTES@ ] || fail root-size
[ "$(wc -c <"$D/bootstrap.uImage")" = @INIT_BYTES@ ] || fail bootstrap-size
@PLATFORM_CHECKS@
root_cap=$(($(cat /sys/class/ubi/ubi0_6/reserved_ebs) * $(cat /sys/class/ubi/ubi0/eraseblock_size)))
init_cap=$(($(cat /sys/class/ubi/ubi0_8/reserved_ebs) * $(cat /sys/class/ubi/ubi0/eraseblock_size)))
[ @ROOT_BYTES@ -le "$root_cap" ] && [ @INIT_BYTES@ -le "$init_cap" ] || fail volume-capacity
if [ ! -r /sys/class/ubi/ubi1/mtd_num ]; then "$BB" ubiattach /dev/ubi_ctrl -m 2 -d 1; fi
[ "$(cat /sys/class/ubi/ubi1/mtd_num)" = 2 ] || fail boot-mapping
if [ ! -r /sys/class/ubi/ubi2/mtd_num ]; then "$BB" ubiattach /dev/ubi_ctrl -m 4 -d 2; fi
[ "$(cat /sys/class/ubi/ubi2/mtd_num)" = 4 ] || fail data-mapping
[ "$(cat /sys/class/ubi/ubi2_0/name)" = owrt-data ] || fail data-volume
! "$BB" grep -q '^ubi2:owrt-data ' /proc/mounts || fail data-already-mounted
[ ! -L "$DATA" ] || fail unsafe-data-mountpoint
mkdir -p "$DATA"
"$BB" mount -t ubifs ubi2:owrt-data "$DATA"; mounted=1
U=$DATA/upper
[ -d "$U" ] && [ ! -L "$U" ] || fail upper-directory
[ ! -e "$DATA/.hh-factory-reset-v1" ] || fail factory-reset-pending
parent_check() {
 [ ! -e "$U/$1.hh-update-new" ] && [ ! -L "$U/$1.hh-update-new" ] || fail stale-temp-file
 n=$1; current=$U; parent=${n%/*}; oldifs=$IFS; IFS=/; set -- $parent; IFS=$oldifs
 for part in "$@"; do
  current=$current/$part
  [ ! -L "$current" ] || fail symlink-parent
  [ ! -e "$current" ] || [ -d "$current" ] || fail non-directory-parent
 done
 [ ! -d "$U/$n" ] || [ -L "$U/$n" ] || fail managed-directory
}
cat >"$LOCK/managed-paths" <<'HH_MANAGED_PATHS'
@MANAGED_PATHS@
HH_MANAGED_PATHS
while IFS= read -r n; do parent_check "$n"; done <"$LOCK/managed-paths"
oldroot=$(sha256sum /dev/ubi0_6 | cut -d ' ' -f1)
oldinit=$(sha256sum /dev/ubi0_8 | cut -d ' ' -f1)
need_kb=$(( ($(cat /sys/class/ubi/ubi0_6/data_bytes) + $(cat /sys/class/ubi/ubi0_8/data_bytes)) / 1024 + 16384 ))
free_kb=$(df -Pk "$DATA" | awk 'END {print $4}')
[ "$free_kb" -gt "$need_kb" ] || fail insufficient-backup-space
[ ! -L "$DATA/.hh-updates" ] || fail backup-symlink
mkdir -p "$DATA/.hh-updates"
B=$DATA/.hh-updates/$(date -u +%Y%m%dT%H%M%S)-$$
mkdir -m 700 "$B"
cat /dev/ubi0_6 >"$B/root.squashfs"
cat /dev/ubi0_8 >"$B/bootstrap.uImage"
check_hash "$B/root.squashfs" "$oldroot"
check_hash "$B/bootstrap.uImage" "$oldinit"
cp "$D/manifest.json" "$B/update-manifest.json"
printf '%s  root.squashfs\n%s  bootstrap.uImage\n' "$oldroot" "$oldinit" >"$B/before.sha256"
set --
while IFS= read -r n; do
 if [ -e "$U/$n" ] || [ -L "$U/$n" ]; then set -- "$@" "$n"; fi
done <"$LOCK/managed-paths"
if [ "$#" -gt 0 ]; then tar -czf "$B/platform-before.tar.gz" -C "$U" "$@"; fi
cp "$LOCK/managed-paths" "$B/managed-paths.txt"
refresh_kb=$(du -sk "$D/platform" | awk 'END {print $1}')
free_kb=$(df -Pk "$DATA" | awk 'END {print $4}')
[ "$free_kb" -gt "$((refresh_kb + 4096))" ] || fail insufficient-refresh-space
sync
echo "HH_UPDATE_BACKUP=$B"
echo HH_UPDATE_PREFLIGHT_OK
[ "$action" = --install ] || exit 0
if [ "$oldroot" != @ROOT_HASH@ ]; then "$BB" ubiupdatevol /dev/ubi0_6 "$D/root.squashfs"; fi
check_hash /dev/ubi0_6 @ROOT_HASH@
if [ "$oldinit" != @INIT_HASH@ ]; then "$BB" ubiupdatevol /dev/ubi0_8 "$D/bootstrap.uImage"; fi
check_hash /dev/ubi0_8 @INIT_HASH@
refresh_file() {
 n=$1; mode=$2; parent_check "$n"; mkdir -p "$U/${n%/*}"
 [ ! -e "$U/$n.hh-update-new" ] && [ ! -L "$U/$n.hh-update-new" ] || fail stale-temp-file
 cp "$D/platform/$n" "$U/$n.hh-update-new"; chmod "$mode" "$U/$n.hh-update-new"; chown 0:0 "$U/$n.hh-update-new"
 mv -fT "$U/$n.hh-update-new" "$U/$n"
}
refresh_link() {
 n=$1; target=$2; parent_check "$n"; mkdir -p "$U/${n%/*}"
 [ ! -e "$U/$n.hh-update-new" ] && [ ! -L "$U/$n.hh-update-new" ] || fail stale-temp-link
 ln -s "$target" "$U/$n.hh-update-new"; mv -fT "$U/$n.hh-update-new" "$U/$n"
}
@PLATFORM_REFRESH@
@UPPER_CHECKS@
sync
echo HH_UPDATE_READBACK_OK_DATA_PRESERVED
