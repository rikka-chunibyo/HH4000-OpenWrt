+/* HH4000 vendor kernel: RTM_NEWLINK bridge attributes panic validate_nla.
+ * Keep netifd's normal ownership/membership model, using the legacy API only
+ * for bridge creation and its matching sysfs configuration interface.
+ */
+static int hh_bridge_attr(const char *ifname, const char *name, uint64_t value,
+                          bool optional)
+{
+ char path[256], buf[32];
+ int fd, len, err;
+ snprintf(path, sizeof(path), "/sys/class/net/%s/bridge/%s", ifname, name);
+ fd = open(path, O_WRONLY | O_CLOEXEC);
+ if (fd < 0)
+  return optional && errno == ENOENT ? 0 : -errno;
+ len = snprintf(buf, sizeof(buf), "%llu\n", (unsigned long long)value);
+ err = write(fd, buf, len) == len ? 0 : -errno;
+ close(fd);
+ return err;
+}
