#!/bin/sh /etc/rc.common
START=95
STOP=5
USE_PROCD=1
start_service() {
 /usr/libexec/hh-sqm recover || return 1
 . /lib/functions.sh
 config_load hh_sqm
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 procd_open_instance
 procd_set_param command /usr/libexec/hh-sqm run
 procd_set_param file /etc/config/hh_sqm
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_close_instance
}
reload_service() { restart; }
service_triggers() {
 procd_add_reload_trigger hh_sqm network
 . /lib/functions.sh
 config_load hh_sqm
 config_get network main network wan
 procd_add_interface_trigger "interface.*" "$network" /etc/init.d/hh-sqm restart
}
