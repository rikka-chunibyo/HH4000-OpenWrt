config panel 'main'
 option enabled '1'
 option screen '1'
 option title 'OpenWrt HH4000'
 option brightness '60'
 option idle_timeout '60'
 option status_network 'lan'
 option message_line1 'Welcome'
 option message_line2 ''
 option main_led 'status'
 option ok_led 'white'
 option navigation_leds 'active'
 option up_action 'previous'
 option down_action 'next'
 option ok_action 'select'
 option main_action 'home'
 option mode 'pages'
 option rotate_seconds '0'
 option hold_ms '1000'
 option start_page 'home'
 option up_led 'white'
 option down_led 'white'
 option up_hold 'none'
 option down_hold 'none'
 option ok_hold 'none'
 option main_hold 'none'
 option reset_action 'reboot'
 option reset_hold 'factory-reset'
 option reset_hold_ms '15000'

config page 'home'
 option enabled '1'
 option label 'Home'
 option font 'normal'
 option align 'center'
 option line1 '{title}'
 option line2 '{ip|LAN waiting}'

config page 'lan'
 option enabled '1'
 option label 'LAN ports'
 option font 'normal'
 option align 'center'
 option line1 'LAN 1 2 3 4 10G'
 option line2 '{ports}'

config page 'wifi'
 option enabled '1'
 option label 'Wi-Fi'
 option font 'normal'
 option align 'center'
 option line1 '{wifi1}'
 option line2 '{wifi2}'

config page 'system'
 option enabled '1'
 option label 'System'
 option font 'normal'
 option align 'center'
 option line1 'Up {uptime}'
 option line2 'Load {load} RAM {memory}%'

config page 'message'
 option enabled '1'
 option label 'Message'
 option font 'normal'
 option align 'center'
 option line1 '{message_line1}'
 option line2 '{message_line2}'
