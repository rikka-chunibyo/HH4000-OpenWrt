#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=95
USE_PROCD=1
start_service() {
 umask 077
 config_load hh_frontpanel
 config_get_bool enabled main enabled 1
 if [ "$enabled" != 1 ]; then
  /usr/libexec/hh-frontpanel-init || return 1
  procd_open_instance panel
  procd_set_param command /usr/sbin/hh-frontpanel-run --blank-panel
  procd_set_param stderr 1
  procd_close_instance
  return 0
 fi
 /usr/libexec/hh-frontpanel-config || return 1
 /usr/libexec/hh-frontpanel-init || return 1
 procd_open_instance status
 procd_set_param command /usr/libexec/hh-frontpanel-status
 procd_set_param file /etc/config/hh_frontpanel
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_close_instance
 procd_open_instance panel
 procd_set_param command /usr/sbin/hh-frontpanel-run
 procd_set_param file /var/run/hh-frontpanel/config
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_set_param term_timeout 5
 procd_close_instance
 config_get mode main mode pages
 if [ "$mode" = python ]; then
  if [ -x /usr/bin/python3 ]; then
   procd_open_instance app
   procd_set_param command /usr/bin/hh-panel-python /usr/libexec/hh-frontpanel-app
   procd_set_param file /var/run/hh-frontpanel/program.py
   procd_set_param stdout 1
   procd_set_param stderr 1
   procd_close_instance
  else
   printf '%s\n' '{"running":false,"error":"Python support is not installed"}' >/var/run/hh-frontpanel/app.json
  fi
 else
  printf '%s\n' '{"running":false,"error":""}' >/var/run/hh-frontpanel/app.json
 fi
}
service_triggers() { procd_add_reload_trigger hh_frontpanel; }
