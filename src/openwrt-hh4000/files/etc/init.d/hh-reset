#!/bin/sh /etc/rc.common
START=94
STOP=6
USE_PROCD=1
start_service() {
 /usr/libexec/hh-reset-config || return 1
 /usr/libexec/hh-frontpanel-init || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/hh-reset-run
 procd_set_param file /var/run/hh-reset/config
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger hh_frontpanel; }
